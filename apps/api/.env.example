# ── App ──────────────────────────────────────────────
APP_ENV=development
# Public URL of this API — used to build tracking / unsubscribe links in emails.
# In production point this at your custom tracking domain (e.g. https://t.yourdomain.com).
PUBLIC_API_URL=http://localhost:8010
WEB_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010

# ── Database / Redis (docker-compose ports) ─────────
DATABASE_URL=postgresql+asyncpg://sfmail:sfmail_password@localhost:5440/sfmail
REDIS_URL=redis://localhost:6390/0

# ── Security ─────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
# Fernet key for secrets at rest (SMTP passwords, OAuth tokens, API keys).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── First super admin (created by `python -m app.seed`) ─
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me

# ── Google OAuth (Gmail / Workspace mailboxes) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OAuth (Outlook / 365 mailboxes) ────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ── Email verifier (needs outbound port 25 on the server) ─
VERIFIER_HELO_DOMAIN=verify.example.com
VERIFIER_MAIL_FROM=check@verify.example.com
