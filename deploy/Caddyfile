# Reverse proxy + automatic HTTPS (Let's Encrypt) on one host.
# /api/* (incl. tracking, unsubscribe, OAuth callbacks) goes to the API; everything else to the web app.
# Only runs when COMPOSE_PROFILES=proxy is set in deploy/.env.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3010
	}
}
