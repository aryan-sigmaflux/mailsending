# Copy to deploy/.env on the server and fill in. Never commit the real file.
APP_ENV=production
WEB_PORT=3010
API_PORT=8010
# 0.0.0.0 = reachable on the server IP. Switch to 127.0.0.1 once the HTTPS proxy below is on.
BIND_ADDR=0.0.0.0

# --- HTTPS proxy (Caddy on 80/443). Uncomment once the DNS A record points at the server. ---
# One host serves both: /api/* goes to the API, everything else to the web app.
# COMPOSE_PROFILES=proxy
# APP_DOMAIN=sendharbor.sigmaflux.in
# ACME_EMAIL=you@sigmaflux.in

# Public URLs (used for CORS, OAuth redirects, tracking/unsubscribe links in emails).
# With the proxy, set all three to https://sendharbor.sigmaflux.in
PUBLIC_API_URL=http://YOUR_SERVER_IP:8010
WEB_URL=http://YOUR_SERVER_IP:3010
CORS_ORIGINS=http://YOUR_SERVER_IP:3010

POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
VERIFIER_HELO_DOMAIN=verify.example.com
VERIFIER_MAIL_FROM=check@verify.example.com
