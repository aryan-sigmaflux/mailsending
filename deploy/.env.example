# Copy to deploy/.env on the server and fill in. Never commit the real file.
APP_ENV=production
WEB_PORT=3010
API_PORT=8010
# Web and API listen on localhost only; the aaPanel nginx (deploy/nginx/sendharbor.conf) serves them publicly.
BIND_ADDR=127.0.0.1

# Public URLs (used for CORS, OAuth redirects, tracking/unsubscribe links in emails).
# One host: nginx sends /api/* to the API and everything else to the web app.
PUBLIC_API_URL=https://sendharbor.sigmaflux.in
WEB_URL=https://sendharbor.sigmaflux.in
CORS_ORIGINS=https://sendharbor.sigmaflux.in

POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
VERIFIER_HELO_DOMAIN=verify.example.com
VERIFIER_MAIL_FROM=check@verify.example.com
